{
  "name": "dsh-inline-render",
  "version": "0.1.0",
  "description": "DSH plugin: render SVG / raster images INLINE in the main conversation over a loopback-only media route. Works around the host markdown renderer's deliberate lack of an HTML branch without patching it. / 让 DSH 主对话内联出图（本地回环图床 + 工具调用）。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "inline",
    "svg",
    "diagram",
    "render"
  ],
  "author": "Singingmen",
  "repository": {
    "type": "git",
    "url": "https://github.com/Singingmen/dsh-inline-render"
  },
  "homepage": "https://github.com/Singingmen/dsh-inline-render#readme",
  "bugs": {
    "url": "https://github.com/Singingmen/dsh-inline-render/issues"
  },
  "private": true
}
